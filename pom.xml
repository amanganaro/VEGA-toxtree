<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>InSilico</groupId>
    <artifactId>ToxTreeRules</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>VEGA ToxTree rules</name>
    <description>
        Cramer and Verhaar decision trees, ported to CDK 2.x. Derived from Toxtree (Ideaconsult Ltd.), GPL v2 or
        later. The library depends on CDK only: it takes an already normalized IAtomContainer and returns the
        assigned category plus the decision trace.
    </description>

    <licenses>
        <license>
            <name>GNU General Public License, version 2 or later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cdk.version>2.3</cdk.version>
    </properties>

    <repositories>
        <repository>
            <id>protoqsar-maven-public</id>
            <url>https://nexus.protoqsar.com/repository/maven-public/</url>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>protoqsar-maven-releases</id>
            <url>https://nexus.protoqsar.com/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>org.openscience.cdk</groupId>
            <artifactId>cdk-bundle</artifactId>
            <version>${cdk.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!--
            Only the tests use the VEGA core, to normalize molecules exactly as the models will. The library
            itself stays free of it: see the note on the input contract in the README.
        -->
        <dependency>
            <groupId>InSilico</groupId>
            <artifactId>Core</artifactId>
            <version>1.3.23</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Validation against the original Toxtree, used to generate the reference decision traces.
            Off by default: it needs the IdeaConsult repository, which is outside our control.
        -->
        <profile>
            <id>toxtree-reference</id>
            <repositories>
                <repository>
                    <id>nexus-idea-releases</id>
                    <url>https://nexus.ideaconsult.net/content/repositories/releases</url>
                </repository>
            </repositories>
            <dependencies>
                <dependency>
                    <groupId>uk.ac.ebi.beam</groupId>
                    <artifactId>beam-core</artifactId>
                    <version>1.3.3</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>InSilico</groupId>
                    <artifactId>ToxTreeWrapper</artifactId>
                    <version>1.0</version>
                    <classifier>shaded</classifier>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>toxtree</groupId>
                    <artifactId>toxtree-cramer</artifactId>
                    <version>3.1.0</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
